OPENAI_API_KEY=
OPENAI_FREE_MODEL=gpt-5.4-mini
OPENAI_PRACTICE_MODEL=gpt-5.4
OPENAI_TIMEOUT_MS=45000

NEXT_PUBLIC_SITE_URL=https://manalio.jp
NEXT_PUBLIC_CONTACT_EMAIL=contact@manalio.jp
NEXT_PUBLIC_LEGAL_SELLER_NAME=Manalio運営者
NEXT_PUBLIC_LEGAL_REPRESENTATIVE=正式提供開始時に表示
NEXT_PUBLIC_LEGAL_ADDRESS=正式提供開始時に表示
NEXT_PUBLIC_LEGAL_PHONE=正式提供開始時に表示
NEXT_PUBLIC_LEGAL_PRICE=導入範囲、学生数、利用期間、学校フォーマット対応範囲に応じた個別見積り
NEXT_PUBLIC_LEGAL_ADDITIONAL_FEES=インターネット接続料金、通信料金等は利用者または導入組織の負担となります。
NEXT_PUBLIC_LEGAL_PAYMENT_METHOD=請求書払い、銀行振込その他個別契約で定める方法
NEXT_PUBLIC_LEGAL_PAYMENT_TIMING=個別契約または請求書に定める期日
NEXT_PUBLIC_LEGAL_SERVICE_START=契約成立後、導入設定およびアカウント発行が完了次第提供します。
NEXT_PUBLIC_LEGAL_CANCELLATION=サービスの性質上、提供開始後の返金は原則として行いません。個別契約で別途定める場合はその内容に従います。
# 教員共有・本番では false。必要な内部デモ時だけ true にする
NEXT_PUBLIC_MANABI_SHOW_DEMO_SHORTCUTS=false
# PoC前の合意までは false。CSV/JSON書き出しを許可する時だけ true にする
NEXT_PUBLIC_MANABI_ENABLE_LOG_EXPORTS=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# スキーマ適用時だけ使う。Vercel等には置かない
SUPABASE_DB_URL=

ANTHROPIC_API_KEY=
ANTHROPIC_FREE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_PRACTICE_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_MS=45000

# Amazon Bedrock Guardrails検証。明示フラグなしでは実APIを呼ばない
AWS_BEDROCK_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MANABI_BEDROCK_GUARDRAIL_ID=
MANABI_BEDROCK_GUARDRAIL_VERSION=DRAFT
MANABI_BEDROCK_GUARDRAIL_MODE=off
MANABI_BEDROCK_GUARDRAIL_TIMEOUT_MS=5000
MANABI_CREATE_BEDROCK_GUARDRAIL=false
MANABI_RUN_BEDROCK_GUARDRAILS=false

# 初期PoCはOpenAI API条件で説明しやすいよう、標準ではOpenAIに固定
MANABI_FREE_PROVIDER=openai
MANABI_PRACTICE_PROVIDER=openai
MANABI_ALLOW_PROVIDER_FALLBACK=false

# 外部AI API残高を使わずに画面だけ確認する。先生レビューでは true を基本にする
MANABI_USE_MOCK=true
# 実モデルでプロンプト回帰テストを行う時だけ true
MANABI_RUN_PROMPT_REGRESSION=false

# Supabase Auth設定時はAI生成APIをログイン必須にする
MANABI_REQUIRE_AUTH_FOR_GENERATE=true
MANABI_STUDENT_DAILY_GENERATION_LIMIT=20
MANABI_STAFF_DAILY_GENERATION_LIMIT=120

# 本番ではfalse推奨。学校管理者が招待・プロフィール作成する
MANABI_ALLOW_PUBLIC_SIGNUP=false
# 学校フォーマットAPIのPUT保存・復元検証を実行する時だけtrue
MANABI_ALLOW_TEMPLATE_WRITE=false

# Supabase検証用。seed/verify時だけ利用
MANABI_SEED_PASSWORD=
MANABI_DEMO_TEACHER_EMAIL=teacher@example.ac.jp
MANABI_DEMO_STUDENT_EMAIL=student@example.ac.jp
MANABI_DEMO_OUTSIDER_EMAIL=outsider@example.ac.jp
MANABI_APP_URL=http://localhost:3011
# 応募フォームや外部共有に貼る応募用公開Web URL。/demo を含め、MANABI_APP_URL/NEXT_PUBLIC_SITE_URLとは分ける
MANABI_APPLICATION_PUBLIC_URL=
# 応募フォームや外部共有に補足で貼る応募用GitHub URL。現在の作業repoのremoteとは分ける
MANABI_APPLICATION_GITHUB_URL=
# 応募用公開Web URLで /demo だけを見せる場合は true。/login と /app は /demo へ戻す
MANABI_PUBLIC_DEMO_ONLY=false
# 実モデルの最終出力確認で使うログイン情報。未設定なら教員デモアカウントを利用
MANABI_PROMPT_TEST_EMAIL=
MANABI_PROMPT_TEST_PASSWORD=
